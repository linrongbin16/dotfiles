ghostty_configs() {
  mkdir -p "$HOME/.config"
  if [ -d "$HOME/.config/ghostty" ]; then
    rm -rf $HOME/.config/ghostty
  fi
  if [ "$IS_MAC" == "1" ]; then
    ln -s $HOME/.dotfiles/ghostty_mac $HOME/.config/ghostty
  else
    ln -s $HOME/.dotfiles/ghostty_unix $HOME/.config/ghostty
  fi

  touch "$HOME/.config/ghostty/ghostty-custom"
}

profile_configs() {
  local zshrc="$HOME/.zshrc"
  local line='[ -f ~/.dotfiles/dotfiles.zsh ] && source ~/.dotfiles/dotfiles.zsh'

  # Re-running `install` used to append this block again every time, so the
  # file grew by three lines per run and sourced `dotfiles.zsh` more than once.
  # Check for the `source` line itself rather than the `# dotfiles` marker,
  # because earlier versions wrote the marker with a trailing space.
  if grep -qxF "$line" "$zshrc" 2>/dev/null; then
    info "'$zshrc' already sources dotfiles.zsh, skip..."
    return 0
  fi

  if ! printf '\n%s\n%s\n' '# dotfiles' "$line" >>"$zshrc"; then
    info "failed to append to '$zshrc'"
    return 1
  fi
}

main() {
  core_deps
  js_deps
  go_deps
  rust_deps
  prompt_deps
  git_configs
  # alacritty_configs
  # kitty_configs
  ghostty_configs
  profile_configs
  info "done"
}

main
