#!/bin/bash

# Fail fast: any command that fails aborts the whole installation with its own
# exit code, instead of running to the end and reporting success because the
# last step happened to work.
#
# `-u` catches typos in variable names (`$HOM` instead of `$HOME` would
# otherwise expand to nothing and quietly install into the wrong place).
#
# `-E` propagates the ERR trap into functions and subshells. Without it the trap
# set in `install()` never fires for the command it evaluates, so a failure
# would kill the script with no hint about which tool was being installed.
#
# `pipefail` makes `curl ... | sh` report curl's failure rather than the exit
# code of `sh`, which happily reads an empty script and exits 0.
#
# These only apply to commands run unprotected. Anything wrapped in `if`, `||`
# or `&&` is exempt from errexit, so `install()` deliberately runs its command
# bare.
#
# `./install` sets the same options, but `exec` replaces the process with a
# fresh `zsh` that starts from its own defaults - shell options are not part of
# the environment it inherits - so they have to be set again here.
set -Eeuo pipefail

# What this machine is. Computed once, here, and exported: the `exec` at the
# bottom starts a fresh `zsh` with this environment, so `inst/install.sh` reads
# the values back instead of repeating the same `uname` calls and the same
# architecture mapping.
DOTFILES_HOME="$HOME/.dotfiles"
OS="$(uname -s)"
ARCH="$(uname -m)"

# The names the release assets use, which are neither `uname -m`'s nor each
# other's.
DOTFILES_ARCH="$ARCH"
case "$ARCH" in
x86_64) DOTFILES_ARCH="amd64" ;;
aarch64 | arm64) DOTFILES_ARCH="arm64" ;;
esac

IS_ARM=0
case "$ARCH" in
aarch64 | arm*) IS_ARM=1 ;;
esac

IS_MAC=0
case "$OS" in
Darwin) IS_MAC=1 ;;
esac

export DOTFILES_HOME OS DOTFILES_ARCH IS_ARM IS_MAC

. "$DOTFILES_HOME/inst/util.sh"

trap 'report_failure' ERR

# The Command Line Tools are what put `clang` / `clang++` in the terminal; a
# full Xcode is only needed for simulators and iOS work.
install_command_line_tools() {
  # `xcode-select -p` happily names a directory that does not exist yet, so ask
  # the compiler itself whether it runs.
  if /usr/bin/xcrun --find clang >/dev/null 2>&1; then
    skip_info "xcode command line tools"
    return 0
  fi

  info "install 'xcode command line tools' with: 'softwareupdate -i'"

  # `softwareupdate` lists the tools only while this placeholder file exists.
  # Same trick as Homebrew's own installer; the download is 1-2 GB, so expect
  # this step to take a while.
  local placeholder label
  placeholder=/tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
  sudo touch "$placeholder"
  label="$(softwareupdate -l 2>/dev/null |
    grep -B 1 -E 'Command Line Tools' |
    awk -F'*' '/^ *\*/ {print $2}' |
    sed -e 's/^ *Label: //' -e 's/^ *//' |
    sort -V |
    tail -n1)" || label=""
  sudo rm -f "$placeholder"

  if [ -z "$label" ]; then
    info "'softwareupdate -l' lists no Command Line Tools, install Xcode from the App Store"
    # `report_failure` would otherwise add a generic line after this one.
    DOTFILES_FAILURE_REPORTED=1
    return 1
  fi

  # Name the target for `report_failure`: this is a multi-minute download, and
  # a bare "a command failed" would not say what was being installed.
  DOTFILES_CURRENT_TARGET="xcode command line tools"
  sudo softwareupdate -i "$label"
  DOTFILES_CURRENT_TARGET=""

  # `softwareupdate` does not always point the developer directory at the tools
  # it just installed, and `xcrun` then still refuses to find clang.
  if ! /usr/bin/xcrun --find clang >/dev/null 2>&1; then
    DOTFILES_CURRENT_TARGET="xcode command line tools"
    sudo xcode-select --switch /Library/Developer/CommandLineTools
    DOTFILES_CURRENT_TARGET=""
  fi

  info "install 'xcode command line tools' with: 'softwareupdate -i' - done"
}

install_homebrew() {
  if [ -x /opt/homebrew/bin/brew ]; then
    skip_info "homebrew"
    return 0
  fi

  info "install 'homebrew' with: 'install.sh'"

  local script
  script="$(mktemp)"
  curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o "$script"

  # The installer asks for the password through `sudo`. With a terminal it can
  # do that; without one (CI, `./install </dev/null`) it can only run
  # unattended, which needs passwordless sudo.
  if [ -t 0 ]; then
    /bin/bash "$script"
  else
    NONINTERACTIVE=1 /bin/bash "$script"
  fi
  rm -f "$script"

  info "install 'homebrew' with: 'install.sh' - done"
}

# The `zsh` this installation runs under and makes the login shell.
#
# On macOS that is the Homebrew copy, the one `install_zsh` just made sure
# exists and `brew upgrade` keeps current. `command -v zsh` there would find
# `/bin/zsh` instead - the copy macOS ships, which nothing upgrades - and the
# one just installed would go unused.
zsh_binary() {
  if [ "$OS" = "Darwin" ] && [ -x /opt/homebrew/bin/zsh ]; then
    printf '%s\n' /opt/homebrew/bin/zsh
    return 0
  fi
  command -v zsh
}

install_zsh() {
  case "$OS" in
  Linux)
    if type zsh >/dev/null 2>&1; then
      skip_info "zsh"
      return 0
    fi

    # `apt-get install` on its own can pick a package that `apt-get update` has
    # never seen, or one whose index is days out of date.
    sudo apt-get -q -y update
    info "install 'zsh' with: 'apt-get install'"
    DOTFILES_CURRENT_TARGET="zsh"
    sudo apt-get install -q -y zsh
    DOTFILES_CURRENT_TARGET=""
    info "install 'zsh' with: 'apt-get install' - done"
    ;;
  Darwin)
    # macOS ships `/bin/zsh` already, so `type zsh` would find it and skip the
    # step. Name the copy Homebrew installs instead.
    if [ -x /opt/homebrew/bin/zsh ]; then
      skip_info "zsh"
      return 0
    fi

    info "install 'zsh' with: 'brew install zsh'"
    DOTFILES_CURRENT_TARGET="zsh"
    brew install zsh
    DOTFILES_CURRENT_TARGET=""
    info "install 'zsh' with: 'brew install zsh' - done"
    ;;
  esac
}

# Login shell recorded for the current user. Linux keeps it in `/etc/passwd`
# (read through `getent`), macOS in the directory service (`dscl`).
login_shell() {
  case "$OS" in
  Darwin) dscl . -read "/Users/$(id -un)" UserShell | awk '{print $2}' ;;
  *) getent passwd "$(id -un)" | cut -d: -f7 ;;
  esac
}

# Make `zsh` the login shell of the current user, so a terminal started
# tomorrow gets the same shell this installation ran under.
set_login_shell() {
  local zsh_path current
  zsh_path="$(zsh_binary)" || zsh_path=""
  if [ -z "$zsh_path" ]; then
    info "'zsh' is not on PATH after installing it"
    DOTFILES_FAILURE_REPORTED=1
    return 1
  fi

  # `chsh` refuses a shell that `/etc/shells` does not list, which is the case
  # for the copy Homebrew installs. Linux distributions list theirs already.
  if ! grep -qxF "$zsh_path" /etc/shells; then
    info "add '$zsh_path' to '/etc/shells'"
    DOTFILES_CURRENT_TARGET="zsh in /etc/shells"
    printf '%s\n' "$zsh_path" | sudo tee -a /etc/shells >/dev/null
    DOTFILES_CURRENT_TARGET=""
    info "add '$zsh_path' to '/etc/shells' - done"
  fi

  current="$(login_shell)" || current=""
  if [ "$current" = "$zsh_path" ]; then
    skip_info "zsh login shell"
    return 0
  fi

  info "set '$zsh_path' as login shell with: 'chsh -s'"
  # `chsh` asks for a password on its own, which a CI run has no way to answer,
  # so go through `sudo` like every other system change here.
  DOTFILES_CURRENT_TARGET="zsh login shell"
  sudo chsh -s "$zsh_path" "$(id -un)"
  DOTFILES_CURRENT_TARGET=""
  info "set '$zsh_path' as login shell with: 'chsh -s' - done"
}

main() {
  case "$OS" in
  Darwin)
    install_command_line_tools
    install_homebrew
    # An existing Homebrew that this shell's PATH misses: the installer appends
    # `brew shellenv` to `~/.zprofile`, which a non-login shell never reads.
    if ! command -v brew >/dev/null 2>&1; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
    ;;
  Linux) ;;
  *)
    info "$OS is not supported, exit..."
    exit 1
    ;;
  esac

  install_zsh
  set_login_shell

  local zsh_path
  zsh_path="$(zsh_binary)"
  info "run the rest of the installation with: '$zsh_path'"
  # `exec` replaces this process, so `inst/install.sh` runs as the only thing
  # the user waits on, and its exit code is this script's exit code.
  exec "$zsh_path" "$DOTFILES_HOME/inst/install.sh"
}

main
