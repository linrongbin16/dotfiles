#!/bin/bash

# Fail fast: any command that fails aborts the whole installation with its own
# exit code, instead of running to the end and reporting success because the
# last step happened to work.
#
# `-u` catches typos in variable names (`$HOM` instead of `$HOME` would
# otherwise expand to nothing and quietly install into the wrong place).
#
# `-E` propagates the ERR trap into functions and subshells. Without it the trap
# set in `install()` never fires for the command it evaluates, so a failure
# would kill the script with no hint about which tool was being installed.
#
# `pipefail` makes `curl ... | sh` report curl's failure rather than the exit
# code of `sh`, which happily reads an empty script and exits 0.
#
# These only apply to commands run unprotected. Anything wrapped in `if`, `||`
# or `&&` is exempt from errexit, so `install()` deliberately runs its command
# bare.
set -Eeuo pipefail

# set -x

OS="$(uname -s)"
ARCH="$(uname -m)"

IS_ARM=0
if [[ "$ARCH" == "arm64" || "$ARCH" == "aarch64" ]]; then
  IS_ARM=1
fi

IS_MAC=0
case "$OS" in
Darwin)
  IS_MAC=1
  ;;
esac

export DOTFILES_HOME="$HOME/.dotfiles"

. "$DOTFILES_HOME/inst/util.sh"

# Installed once, after `util.sh` defines `report_failure`. Covers the bare
# commands in `inst/apt.sh` and `inst/brew.sh` too, which are just as likely to
# fail as anything wrapped in `install()`.
trap 'report_failure' ERR

core_deps() {
  case "$OS" in
  Linux)
    . "$DOTFILES_HOME/inst/apt.sh"
    ;;
  Darwin)
    . "$DOTFILES_HOME/inst/brew.sh"
    ;;
  *)
    info "$OS is not supported, exit..."
    exit 1
    ;;
  esac
}

git_configs() {
  git config --global user.email "linrongbin16@outlook.com"
  git config --global user.name "linrongbin16"
  git config --global pull.rebase false
  git config --global init.defaultBranch main
}

js_deps() {
  install "curl -fsSL https://deno.land/install.sh | sh -s -- -y" "deno"
  install "curl -fsSL https://bun.com/install | bash" "bun"
}

go_deps() {
  install "go install github.com/jesseduffield/lazygit@latest" "lazygit"
  install "go install github.com/walles/moor/v2/cmd/moor@latest" "moor"
  install "go install github.com/umlx5h/gtrash@latest" "gtrash"
}

# rust
rust_deps() {
  # The rustup installer edits the *user* PATH, which this shell never re-reads, so
  # `cargo` would stay "not found" for the `cargo install` calls below on a fresh
  # machine. Done first: every probe here should look where the install puts its shims.
  export PATH="$HOME/.cargo/bin:$PATH"

  install "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y" "rustup"

  # `rustup` ships `rustc`/`cargo` as shims that are on PATH as soon as the installer
  # finishes, even when no toolchain is downloaded yet - so `type rustc` says yes on a
  # machine that has rustup but no toolchain, and then every `cargo install` below fails
  # with "no default toolchain configured". Running them is the only probe that tells
  # those two states apart.
  if ! rustc --version >/dev/null 2>&1 || ! cargo --version >/dev/null 2>&1; then
    info "install 'rustc/cargo' with: 'rustup default stable'"
    rustup default stable
    info "install 'rustc/cargo' with: 'rustup default stable' - done"
  else
    skip_info "rustc/cargo"
  fi

  install "cargo install fd-find" "fd"
  install "cargo install ripgrep" "rg"
  install "cargo install --locked bat" "bat"
  install "cargo install eza" "eza"
  install "cargo install --locked rmz" "rmz"
  install "cargo install --locked cpz" "cpz"
  install "cargo install --locked tree-sitter-cli" "tree-sitter"
}

prompt_deps() {
  # git-prompt
  mkdir -p "$HOME/.config"
  mkdir -p "$HOME/.zsh"
  if [ ! -d "$HOME/.zsh/git-prompt.zsh" ]; then
    git clone --depth=1 https://github.com/woefe/git-prompt.zsh $HOME/.zsh/git-prompt.zsh
  fi

  # atuin
  install "curl --proto '=https' --tlsv1.2 -LsSf https://setup.atuin.sh | sh -s -- --non-interactive" "atuin"
  mkdir -p $HOME/.atuin
  if [ ! -f "$HOME/.atuin/config.toml" ]; then
    cp $HOME/.dotfiles/atuin.toml $HOME/.atuin/config.toml
  fi
}

